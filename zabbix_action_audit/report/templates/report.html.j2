<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if single %}{{ r.actions[0].name }} — {% endif %}Аудит действий Zabbix</title>
{% include "_style.html.j2" %}
</head>
<body>
<header>
  {% if index_link %}<div class="nav"><a href="index.html">← все действия</a></div>{% endif %}
  <h1>Аудит действий триггеров Zabbix</h1>
  <div class="meta">Zabbix {{ r.meta.version }} · <a href="{{ r.meta.frontend }}">{{ r.meta.frontend }}</a> · данные от {{ r.meta.generated }} · отчёт {{ r.meta.audited }}
  {% if r.meta.token_user %} · учётная запись {{ r.meta.token_user.username }}{% if r.meta.token_user.type != 3 %} <span class="badge WARN">не Super admin — данные могут быть неполными</span>{% endif %}{% endif %}</div>
</header>
<main>
  <div class="tiles">
    {% for lvl, n in summary.items() %}<div class="tile {{ lvl }}"><b>{{ n }}</b>{{ lvl }}</div>{% endfor %}
    <div class="tile"><b>{{ r.actions|length }}</b>действий</div>
  </div>
  <div class="muted">Счётчики — по включённым действиям: пары «получатель × проблема» плюс находки уровня действия/операции.</div>

  <div class="controls">
    <span class="seg" id="modes">
      {% for m in r.modes %}<button data-mode="{{ m }}" class="{{ 'on' if loop.first }}">{{ mode_titles[m] }}</button>{% endfor %}
    </span>
    {% for lvl in ["FAIL", "WARN", "INFO", "OK"] %}
    <label><input type="checkbox" class="lvl" value="{{ lvl }}" checked> <span class="badge {{ lvl }}">{{ lvl }}</span></label>
    {% endfor %}
    <label{{ ' class="hidden"' if single }}><input type="checkbox" id="showDisabled" checked> отключённые действия</label>
    <input type="search" id="q" placeholder="Поиск: действие, пользователь, триггер, хост">
    <button id="expand" class="seg" style="padding:6px 10px;cursor:pointer">Развернуть все</button>
  </div>

  {% for a in r.actions %}
  <details class="action"{{ " open" if single }} data-enabled="{{ 1 if a.enabled else 0 }}" data-search="{{ a.name|lower }}">
    <summary>
      <span class="badge {{ a.worst }}">{{ a.worst }}</span>
      <span class="name">{{ a.name }}</span>
      <span class="muted">id {{ a.actionid }}</span>
      {% if not a.enabled %}<span class="badge off">отключено</span>{% endif %}
      <span class="counts">
        {% for mode, m in a.modes.items() %}
        <span class="mode-only" data-mode="{{ mode }}">
          <span class="muted">подходит {{ m.matched|length }}{% if m.undecided %} + {{ m.undecided|length }}?{% endif %}</span>
          {% for lvl in ["FAIL", "WARN"] %}{% if m.counts[lvl] %}<span class="badge {{ lvl }}">{{ m.counts[lvl] }}</span>{% endif %}{% endfor %}
        </span>
        {% endfor %}
      </span>
    </summary>
    <div class="body">
      <div class="muted">Условия ({{ a.evaltype }}):</div>
      {% if a.conditions %}<ul class="conds">{% for c in a.conditions %}<li>{{ c }}</li>{% endfor %}</ul>
      {% else %}<div class="conds">нет — под действие подпадают все проблемы</div>{% endif %}
      {% if a.findings %}<ul class="findings">{% for f in a.findings %}<li class="f" data-level="{{ f.level }}"><span class="badge {{ f.level }}">{{ f.level }}</span> {{ f.message }} <code class="muted">{{ f.code }}</code></li>{% endfor %}</ul>{% endif %}

      {% for mode, m in a.modes.items() %}
      <div class="mode-only" data-mode="{{ mode }}" data-undecided="{{ und(m.undecided)|forceescape }}">
        {% if m.findings %}<ul class="findings">{% for f in m.findings %}<li class="f" data-level="{{ f.level }}"><span class="badge {{ f.level }}">{{ f.level }}</span> {{ f.message }}</li>{% endfor %}</ul>{% endif %}
        {% if m.matched or m.undecided %}
        <details class="lazy" data-mode="{{ mode }}" data-list="{{ ref(m.matched + (m.undecided.keys()|list)) }}">
          <summary>Проблемы, под которые попадает действие: {{ m.matched|length }}{% if m.undecided %} <span class="badge UNK">+ {{ m.undecided|length }} не определено</span>{% endif %}</summary>
          <div class="body"></div>
        </details>
        {% endif %}
        {% for op in m.operations %}
        <details class="op" open>
          <summary><span class="name">{{ op.title }}</span> <span class="muted">{{ op.context }}</span></summary>
          <div class="body">
            {% if op.findings %}<ul class="findings">{% for f in op.findings %}<li class="f" data-level="{{ f.level }}"><span class="badge {{ f.level }}">{{ f.level }}</span> {{ f.message }}</li>{% endfor %}</ul>{% endif %}
            {% for rc in op.recipients %}
            <details class="rcpt" data-search="{{ rc.label|lower }}">
              <summary>
                <span class="name">{{ rc.label }}</span> <span class="muted">{{ rc.via|join(', ') }}</span>
                <span class="counts">{% for lvl in ["FAIL", "WARN", "INFO", "OK"] %}{% if rc.counts[lvl] %}<span class="badge {{ lvl }}">{{ lvl }} {{ rc.counts[lvl] }}</span>{% endif %}{% endfor %}
                {% for f in rc.findings %}{% if f.level in ["FAIL", "WARN"] %}<span class="badge {{ f.level }}" title="{{ f.message }}">{{ f.code }}</span>{% endif %}{% endfor %}</span>
              </summary>
              <div class="body">
                {% if rc.findings %}<ul class="findings">{% for f in rc.findings %}<li class="f" data-level="{{ f.level }}"><span class="badge {{ f.level }}">{{ f.level }}</span> {{ f.message }}</li>{% endfor %}</ul>{% endif %}
                {% for g in rc.outcomes %}
                <details class="lazy f" data-level="{{ g.level }}" data-mode="{{ mode }}" data-list="{{ ref(g.candidates) }}">
                  <summary><span class="badge {{ g.level }}">{{ g.level }}</span> {{ g.candidates|length }} пробл.
                    {% for code in g.codes %}<code>{{ code }}</code> {% endfor %}
                    {% if not g.codes %}<span class="muted">уведомление будет доставлено</span>{% endif %}</summary>
                  <div class="body">
                    {% if g.details %}<ul class="details-list">{% for d in g.details %}<li>{{ d }}</li>{% endfor %}</ul>{% endif %}
                  </div>
                </details>
                {% endfor %}
              </div>
            </details>
            {% endfor %}
          </div>
        </details>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </details>
  {% endfor %}

  {% if r.uncovered %}
  <h2>Не подпадают ни под одно включённое действие с отправкой сообщений</h2>
  {% for mode, keys in r.uncovered.items() %}
  <details class="lazy mode-only" data-mode="{{ mode }}" data-list="{{ ref(keys) }}" data-undecided="[]">
    <summary>{{ mode_titles[mode] }}: {{ keys|length }}</summary>
    <div class="body"></div>
  </details>
  {% endfor %}
  {% endif %}

  <h2>Коды проверок</h2>
  <details><summary>Расшифровка</summary><div class="body"><table class="legend">
    {% for code, text in r.descriptions.items() %}<tr><td><code>{{ code }}</code></td><td>{{ text }}</td></tr>{% endfor %}
  </table></div></details>
</main>

<script id="candidates" type="application/json">{{ r.candidates|tojson }}</script>
<script id="lists" type="application/json"><!--KEY_LISTS--></script>
<script>
(function () {
  const CANDS = JSON.parse(document.getElementById("candidates").textContent);
  const LISTS = JSON.parse(document.getElementById("lists").textContent);
  const keysOf = el => LISTS[+el.dataset.list] || [];
  const SEV = {{ severities|tojson }};
  let mode = {{ r.modes[0]|tojson if r.modes else '""' }};
  const esc = s => String(s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));

  const PAGE = 500;
  // data-undecided: [[list index, [notes]], ...] — candidates sharing the same notes are stored once
  function undecidedOf(el) {
    const holder = el.closest("[data-undecided]");
    if (!holder) return {};
    if (!holder._und) {
      holder._und = {};
      for (const [ref, notes] of JSON.parse(holder.dataset.undecided || "[]"))
        for (const k of LISTS[ref] || []) holder._und[k] = notes;
    }
    return holder._und;
  }
  const time = c => c.clock ? new Date(c.clock * 1000).toLocaleString() : "";
  function rowHtml(c, und, active) {
    const notes = und[c.key];
    return "<tr><td><span class='sev sev" + c.severity + "'></span>" + esc(SEV[c.severity]) + "</td>" +
      "<td><a href='" + esc(c.url) + "' target='_blank' rel='noopener'>" + esc(c.name) + "</a>" +
      (notes ? " <span class='badge UNK'>не определено</span><div class='muted'>" + esc(notes.join("; ")) + "</div>" : "") +
      "</td><td>" + esc(c.hosts.join(", ")) + "</td>" +
      (active ? "<td>" + esc(time(c)) + (c.suppressed ? " (подавлена)" : "") + "</td>" : "") + "</tr>";
  }
  function renderTable(el) {
    if (el.dataset.rendered) return;
    el.dataset.rendered = "1";
    const body = el.querySelector(":scope > .body");
    const und = undecidedOf(el);
    const pool = CANDS[el.dataset.mode] || {};
    const active = el.dataset.mode === "active";
    const rows = keysOf(el).map(k => pool[k]).filter(Boolean)
      .sort((a, b) => b.severity - a.severity || a.name.localeCompare(b.name));
    body.insertAdjacentHTML("beforeend", '<table><thead><tr><th>Важность</th><th>Проблема / триггер</th><th>Хосты</th>' +
      (active ? "<th>Начало</th>" : "") + "</tr></thead><tbody></tbody></table>");
    const tbody = body.querySelector("tbody");
    let shown = 0, more = null;
    const next = () => {
      tbody.insertAdjacentHTML("beforeend", rows.slice(shown, shown + PAGE).map(c => rowHtml(c, und, active)).join(""));
      shown = Math.min(shown + PAGE, rows.length);
      if (shown >= rows.length) { if (more) more.remove(); return; }
      if (!more) {
        more = document.createElement("button");
        more.className = "more";
        more.addEventListener("click", next);
        body.appendChild(more);
      }
      more.textContent = "Показать ещё " + Math.min(PAGE, rows.length - shown) + " (осталось " + (rows.length - shown) + ")";
    };
    next();
  }
  document.querySelectorAll("details.lazy").forEach(d => d.addEventListener("toggle", () => d.open && renderTable(d)));

  function apply() {
    const levels = new Set([...document.querySelectorAll(".lvl:checked")].map(i => i.value));
    const showDisabled = document.getElementById("showDisabled").checked;
    const q = document.getElementById("q").value.trim().toLowerCase();
    document.querySelectorAll(".mode-only").forEach(e => e.classList.toggle("hidden", e.dataset.mode !== mode));
    document.querySelectorAll(".f").forEach(e => e.classList.toggle("hidden", !levels.has(e.dataset.level)));
    document.querySelectorAll("details.action").forEach(a => {
      let visible = showDisabled || a.dataset.enabled === "1";
      if (visible && q) {
        a._hay = a._hay || {};
        if (a._hay[mode] === undefined) {  // built once per action and mode: search runs on every keystroke
          const pool = CANDS[mode] || {};
          const lazy = a.querySelector("details.lazy[data-mode='" + mode + "']");
          a._hay[mode] = a.dataset.search + " " + [...a.querySelectorAll(".rcpt")].map(r => r.dataset.search).join(" ")
            + " " + (lazy ? keysOf(lazy).map(k => { const c = pool[k]; return c ? (c.name + " " + c.hosts.join(" ")).toLowerCase() : ""; }).join(" ") : "");
        }
        visible = a._hay[mode].includes(q);
      }
      a.classList.toggle("hidden", !visible);
    });
  }
  document.querySelectorAll("#modes button").forEach(b => b.addEventListener("click", () => {
    document.querySelectorAll("#modes button").forEach(x => x.classList.toggle("on", x === b));
    mode = b.dataset.mode; apply();
  }));
  document.querySelectorAll(".lvl, #showDisabled").forEach(i => i.addEventListener("change", apply));
  document.getElementById("q").addEventListener("input", apply);
  let expanded = false;
  document.getElementById("expand").addEventListener("click", e => {
    expanded = !expanded;
    document.querySelectorAll("details.action, details.rcpt").forEach(d => d.open = expanded);
    e.target.textContent = expanded ? "Свернуть все" : "Развернуть все";
  });
  apply();
})();
</script>
</body>
</html>
